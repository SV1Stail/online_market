COMPOSE_PROJECT_NAME=online-market

# Use TLS connections and dedicated least-privilege accounts in production.
DATABASE_URL=
REDIS_URL=

# Both secrets must contain at least 32 random bytes and must be different.
ACCESS_TOKEN_SECRET=
ORDER_TOKEN_SECRET=

# Bind to localhost when TLS is terminated by a reverse proxy on the same host.
GRPC_BIND_ADDRESS=127.0.0.1
GRPC_PORT=8080
TRUSTED_PROXY_CIDRS=172.30.0.0/24

# The gateway is the public HTTP/JSON edge. Keep its private subnet synchronized
# with TRUSTED_PROXY_CIDRS and add the external TLS proxy CIDR when one is used.
GATEWAY_NETWORK_SUBNET=172.30.0.0/24
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8082
GATEWAY_GRPC_INSECURE=true
GATEWAY_GRPC_CA_CERT_FILE=
GATEWAY_GRPC_SERVER_NAME=
GATEWAY_ALLOWED_ORIGINS=
GATEWAY_TRUSTED_PROXY_CIDRS=
GATEWAY_REQUEST_TIMEOUT=6s
GATEWAY_SHUTDOWN_TIMEOUT=10s
GATEWAY_HEALTH_TIMEOUT=2s
GATEWAY_MAX_REQUEST_BODY_BYTES=1048576

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
CART_TTL=168h

NOTIFICATION_CHANNELS=
NOTIFICATION_POLL_INTERVAL=2s
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# The optional admin-create tool reads ADMIN_* variables from the invoking
# shell. Do not persist the initial administrator password in this file.
